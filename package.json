{
  "name": "rate-limiter-gateway",
  "version": "1.0.0",
  "description": "A rate-limiting API gateway built with Node.js and Express.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "loadtest": "node scripts/loadtest.js",
    "verify": "node scripts/verify-limiter.js",
    "verify:redis": "node scripts/verify-redis-limiter.js",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v",
    "test": "echo \"No tests yet\" && exit 0"
  },
  "keywords": [
    "rate-limiter",
    "api-gateway",
    "express",
    "nodejs"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
